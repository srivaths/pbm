# Copy this file to `.env` and fill in the two values from your Supabase project:
#   Supabase dashboard → Project Settings → Data API (and API Keys)
#
# These are safe to expose in a client app (the anon/publishable key is designed
# for that; row-level security in the database is what protects your data).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
